
<div id="sevilla-air-widget">
  <style>
    #sevilla-air-widget {
      --bg: #101c20;
      --panel: #1a2b2e;
      --muted: #91aaa3;
      --white: #f0f6f3;
      --accent: #66d6ae;
      font-family: Inter, system-ui, sans-serif;
      color: var(--white);
      width: 100%;
      max-width: 650px;
      margin: auto;
      background: var(--bg);
      border-radius: 22px;
      padding: 25px;
      box-sizing: border-box;
      box-shadow: 0 15px 45px #10201e20;
    }

    #sevilla-air-widget * { box-sizing: border-box; }

    #sevilla-air-widget .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #34474a;
      padding-bottom: 18px;
    }

    #sevilla-air-widget .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    #sevilla-air-widget .logo {
      background: #173a35;
      color: var(--accent);
      border-radius: 12px;
      padding: 12px;
      font-size: 22px;
    }

    #sevilla-air-widget .brand-name {
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 1px;
    }

    #sevilla-air-widget .subtitle {
      color: var(--muted);
      font-size: 10px;
      letter-spacing: 1.5px;
      margin-top: 4px;
    }

    #sevilla-air-widget .live {
      color: var(--accent);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1px;
    }

    #sevilla-air-widget .location {
      margin-top: 22px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    #sevilla-air-widget .location h2 {
      font-size: 22px;
      margin: 0 0 6px;
    }

    #sevilla-air-widget .coordinates {
      font-size: 12px;
      color: var(--muted);
    }

    #sevilla-air-widget .main {
      text-align: center;
      padding: 30px 0;
    }

    #sevilla-air-widget .gauge {
      --color: #66d6ae;
      width: 174px;
      height: 174px;
      border-radius: 50%;
      margin: auto;
      display: grid;
      place-items: center;
      background: conic-gradient(
        var(--color) var(--progress, 0%),
        #29403e 0
      );
      position: relative;
    }

    #sevilla-air-widget .gauge::before {
      content: "";
      position: absolute;
      inset: 10px;
      background: var(--bg);
      border-radius: 50%;
    }

    #sevilla-air-widget .gauge-content {
      position: relative;
      z-index: 1;
    }

    #sevilla-air-widget .aqi {
      font-size: 48px;
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -2px;
    }

    #sevilla-air-widget .aqi-label {
      color: var(--muted);
      font-size: 10px;
      letter-spacing: 1.5px;
      margin-top: 7px;
    }

    #sevilla-air-widget .status {
      margin-top: 18px;
      font-size: 21px;
      font-weight: 750;
    }

    #sevilla-air-widget .description {
      color: var(--muted);
      font-size: 12px;
      margin-top: 7px;
    }

    #sevilla-air-widget .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    #sevilla-air-widget .pollutant {
      background: var(--panel);
      border: 1px solid #263c3e;
      border-radius: 15px;
      padding: 17px;
    }

    #sevilla-air-widget .pollutant-name {
      font-size: 15px;
      font-weight: 750;
    }

    #sevilla-air-widget .pollutant-description {
      color: var(--muted);
      font-size: 11px;
      margin-top: 5px;
    }

    #sevilla-air-widget .pollutant-value {
      font-size: 26px;
      font-weight: 750;
      margin-top: 15px;
    }

    #sevilla-air-widget .unit {
      color: var(--muted);
      font-size: 11px;
      font-weight: 400;
    }

    #sevilla-air-widget .footer {
      border-top: 1px solid #34474a;
      margin-top: 20px;
      padding-top: 15px;
      color: var(--muted);
      font-size: 10px;
      display: flex;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }

    #sevilla-air-widget .error {
      color: #ffb7a8;
      text-align: center;
      font-size: 12px;
      margin-top: 15px;
    }

    @media(max-width:380px) {
      #sevilla-air-widget { padding: 17px; }
      #sevilla-air-widget .pollutant { padding: 12px; }
    }
  </style>

  <div class="header">
    <div class="brand">
      <div class="logo">〰</div>
      <div>
        <div class="brand-name">SEVILLA AIR</div>
        <div class="subtitle">AIR QUALITY MONITOR</div>
      </div>
    </div>
    <div class="live">● EN DIRECTO</div>
  </div>

  <div class="location">
    <div>
      <h2>Sevilla, España</h2>
      <div class="coordinates">
        37.3891° N · 5.9845° O
      </div>
    </div>
    <div style="font-size:25px">📍</div>
  </div>

  <div class="main">
    <div class="gauge" id="sa-gauge">
      <div class="gauge-content">
        <div class="aqi" id="sa-aqi">--</div>
        <div class="aqi-label">AQI EUROPEO</div>
      </div>
    </div>
    <div class="status" id="sa-status">
      Cargando datos...
    </div>
    <div class="description" id="sa-description">
      Consultando calidad del aire en Sevilla
    </div>
  </div>

  <div class="grid">
    <div class="pollutant">
      <div class="pollutant-name">PM2.5</div>
      <div class="pollutant-description">Partículas finas</div>
      <div class="pollutant-value">
        <span id="sa-pm25">--</span>
        <span class="unit">µg/m³</span>
      </div>
    </div>

    <div class="pollutant">
      <div class="pollutant-name">PM10</div>
      <div class="pollutant-description">Partículas gruesas</div>
      <div class="pollutant-value">
        <span id="sa-pm10">--</span>
        <span class="unit">µg/m³</span>
      </div>
    </div>

    <div class="pollutant">
      <div class="pollutant-name">NO₂</div>
      <div class="pollutant-description">Dióxido de nitrógeno</div>
      <div class="pollutant-value">
        <span id="sa-no2">--</span>
        <span class="unit">µg/m³</span>
      </div>
    </div>

    <div class="pollutant">
      <div class="pollutant-name">O₃</div>
      <div class="pollutant-description">Ozono</div>
      <div class="pollutant-value">
        <span id="sa-o3">--</span>
        <span class="unit">µg/m³</span>
      </div>
    </div>
  </div>

  <div class="footer">
    <span id="sa-updated">Actualizando...</span>
    <span>Fuente: Open-Meteo · CAMS</span>
  </div>
  <div class="error" id="sa-error" role="status"></div>

  <script>
    (() => {
      const root = document.getElementById('sevilla-air-widget');
      if (root.dataset.initialized) return;
      root.dataset.initialized = 'true';

      const $ = id => root.querySelector('#sa-' + id);

      const api =
        'https://air-quality-api.open-meteo.com/v1/air-quality' +
        '?latitude=37.3891&longitude=-5.9845' +
        '&current=european_aqi,pm2_5,pm10,nitrogen_dioxide,ozone' +
        '&timezone=Europe%2FMadrid';

      function quality(aqi) {
        if (aqi <= 20) return {
          name: 'Buena',
          color: '#66d6ae',
          description: 'Calidad del aire excelente. Condiciones favorables.'
        };
        if (aqi <= 40) return {
          name: 'Razonablemente buena',
          color: '#b6d86c',
          description: 'La calidad del aire es generalmente satisfactoria.'
        };
        if (aqi <= 60) return {
          name: 'Moderada',
          color: '#e6ce65',
          description: 'Puede haber efectos en personas sensibles.'
        };
        if (aqi <= 80) return {
          name: 'Mala',
          color: '#eea15b',
          description: 'Conviene limitar esfuerzos prolongados al aire libre.'
        };
        if (aqi <= 100) return {
          name: 'Muy mala',
          color: '#ed795f',
          description: 'Se recomienda precaución, especialmente a grupos sensibles.'
        };
        return {
          name: 'Extremadamente mala',
          color: '#c77acb',
          description: 'Se recomienda reducir la exposición al aire exterior.'
        };
      }

      function format(value) {
        return value == null ? '--' : Number(value).toFixed(1);
      }

      async function update() {
        $('error').textContent = '';

        try {
          const response = await fetch(api);
          if (!response.ok) throw new Error('Error de conexión');

          const data = await response.json();
          const c = data.current;

          if (!c || c.european_aqi == null) {
            throw new Error('Datos no disponibles');
          }

          const aqi = c.european_aqi;
          const q = quality(aqi);

          $('aqi').textContent = aqi;
          $('status').textContent = q.name;
          $('description').textContent = q.description;

          $('gauge').style.setProperty('--color', q.color);
          $('gauge').style.setProperty(
            '--progress',
            Math.min(aqi, 120) / 120 * 100 + '%'
          );

          $('pm25').textContent = format(c.pm2_5);
          $('pm10').textContent = format(c.pm10);
          $('no2').textContent = format(c.nitrogen_dioxide);
          $('o3').textContent = format(c.ozone);

          const date = new Date(c.time);
          $('updated').textContent =
            'Última actualización: ' +
            date.toLocaleString('es-ES', {
              day: '2-digit',
              month: 'short',
              hour: '2-digit',
              minute: '2-digit',
              timeZone: 'Europe/Madrid'
            });

        } catch (error) {
          $('error').textContent =
            'No se han podido cargar los datos. Reintentando próximamente.';
        }
      }

      update();
      setInterval(update, 15 * 60 * 1000);
    })();
  </script>
</div>
